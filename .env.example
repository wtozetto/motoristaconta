# Client ID OAuth do Google (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Sem este valor o app ainda abre, mas mostra a tela explicando a configuração do login.
VITE_GOOGLE_CLIENT_ID=

# Só use "true" em desenvolvimento local. Nunca ative em produção ( pula o login e o Drive).
# VITE_DEV_BYPASS_AUTH=true

# Public Supabase credentials used by the browser (anon key is safe with RLS enabled).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Variáveis exclusivas do backend para o contador (não use prefixo VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (server-side only).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
APP_URL=https://motoristaconta.vercel.app

# Vercel Cron authorization and optional billing e-mail (Resend).
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
